{
  "name": "estate-hooks",
  "version": "0.2.0",
  "description": "The estate's nine Claude Code hook scripts plus a shared gitleaks helper and the statusline, packaged as a plugin.",
  "author": {
    "name": "Lexi James",
    "url": "https://github.com/lexijamesesq"
  },
  "repository": "https://github.com/lexijamesesq/work-lifecycle",
  "license": "MIT",
  "keywords": [
    "hooks",
    "guards",
    "estate"
  ],
  "defaultEnabled": false,
  "hooks": [
    "pr-cache.sh",
    "vault-mcp-redirect.sh",
    "git-hook-bypass-guard.sh",
    "gh-pr-body-guard.sh",
    "linear-transition-guard.sh",
    "gated-verb-standalone-guard.sh",
    "fix-obsidian-claude-sync.sh",
    "profile-symlink-guard.sh",
    "session-init.sh"
  ]
}
