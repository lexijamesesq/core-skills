{
  "description": "Estate hooks: the thirteen Claude Code hook scripts the estate registers, packaged as a plugin. The PR hooks carry no `if` prefilter: a `Bash(gh pr *)` prefilter drops every wrapper-path or variable-held gh command before the hook runs, so each PR hook self-scopes and exits fast instead.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pr-cache.sh",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pr-verdict-watch-arm.sh",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/vault-mcp-redirect.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Read|Grep|Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/security-review-reminder.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/git-hook-bypass-guard.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/git-push-publish-guard.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/estate-identity-guard.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/gh-pr-body-guard.sh",
            "timeout": 30,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/gh-pr-body-template-guard.sh",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/linear-transition-guard.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/linear-transition-guard.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "mcp__linear-tactic__linear_updateIssue"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/fix-obsidian-claude-sync.sh",
            "timeout": 10,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-init.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/estate-mode-advisory.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pr-cache.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-init.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/estate-mode-advisory.sh",
            "timeout": 5,
            "type": "command"
          },
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/pr-cache.sh",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": "resume"
      }
    ]
  }
}
